# Free Coding Agent
# Copy this file to .env only when you need non-default settings.

# HTTP transport. Keep 127.0.0.1 unless you intentionally expose the server.
PORT=3000
MCP_HOST=127.0.0.1

# Required for non-loopback HTTP access. Prefer the Authorization header:
# Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# Optional comma/semicolon-separated browser origins allowed to call the HTTP API.
MCP_ALLOWED_ORIGINS=

# Optional filesystem sandbox. When set, file tools refuse paths outside these roots.
FCA_ALLOWED_ROOTS=

# Workspaces. Set these locally after cloning. Leave blank for no preconfigured workspace.
FCA_WORKSPACES=
FCA_DEFAULT_WORKSPACE=

# Shell and diagnostics.
COMMAND_SHELL=powershell.exe
COMMAND_TIMEOUT_MS=120000
MAX_OUTPUT_CHARS=60000
AUTO_DIAGNOSTICS=true
DIAGNOSTICS_TIMEOUT_MS=60000

# Runtime state. These directories are ignored by Git.
CHECKPOINTS_DIR=.checkpoints
MEMORY_DIR=.memory
JOBS_DIR=.jobs

# Resource admission.
RESOURCE_WAIT_MS=15000
RESOURCE_WAIT_MS_HEAVY=60000
RESOURCE_MAX_COMMANDS=3
RESOURCE_MAX_BACKGROUND=4
RESOURCE_MAX_HEAVY=1
RESOURCE_MAX_ANALYSIS=2
RESOURCE_MAX_AGENT=2
RESOURCE_MAX_LSP=3
RESOURCE_MAX_VIDEO=1
RESOURCE_MIN_FREE_MB_COMMAND=128
RESOURCE_MIN_FREE_MB_BACKGROUND=256
RESOURCE_MIN_FREE_MB_HEAVY=1024
RESOURCE_MIN_FREE_MB_ANALYSIS=512
RESOURCE_MIN_FREE_MB_AGENT=1536
RESOURCE_MIN_FREE_MB_LSP=768
RESOURCE_MIN_FREE_MB_VIDEO=1536
RESOURCE_MAX_CPU_COMMAND=100
RESOURCE_MAX_CPU_BACKGROUND=95
RESOURCE_MAX_CPU_HEAVY=85
RESOURCE_MAX_CPU_ANALYSIS=90
RESOURCE_MAX_CPU_AGENT=85
RESOURCE_MAX_CPU_LSP=90
RESOURCE_MAX_CPU_VIDEO=85

# Playwright browser.
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=.browser-profile
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800
BROWSER_TIMEOUT_MS=15000

# Media.
SCREENSHOTS_DIR=screenshots
CLIPS_DIR=clips
FFMPEG_EXE=ffmpeg

# Optional companion Chrome extension.
FCA_CHROME_BRIDGE_ENABLED=false
CHROME_WS_PORT=3001
CHROME_BRIDGE_TOKEN=
CHROME_EXTENSION_ID=

# Optional VS Code companion extension.
VSCODE_BRIDGE_URL=http://127.0.0.1:3005

# Optional personal HTTPS remote endpoint. `free-coding-agent remote setup`
# writes these locally for the current user. No shared project relay is used.
FCA_REMOTE_PROVIDER=
FCA_REMOTE_URL=
FCA_TAILSCALE_DNS_NAME=
